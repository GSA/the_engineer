# Clean Ubuntu host with systemd for fresh-host acceptance of ./engineer install.
# Only what a stock Ubuntu (WSL or AWS WorkSpaces) image already has, plus sudo for the
# test user: ./engineer install itself installs the remaining packages and Node.js.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus-user-session ca-certificates git python3 sudo \
    && rm -rf /var/lib/apt/lists/*
# Trust host-local CAs (TLS-intercepting proxies) mounted at build time; none are stored in Git.
RUN --mount=type=bind,source=extra-ca,target=/usr/local/share/ca-certificates/extra \
    update-ca-certificates
# Teammates have sudo; the test user gets it without a password because nobody types one here.
# Lingering lets the user manager run without an interactive login.
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u 1000 -s /bin/bash engineer \
    && echo 'engineer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/engineer && chmod 440 /etc/sudoers.d/engineer \
    && mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/engineer
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
